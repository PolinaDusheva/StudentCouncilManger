# Base URL of the API.
# Leave empty in development: requests stay same-origin and the Vite proxy forwards
# /api to the backend, so no CORS is involved.
# Set it for a deployed frontend, e.g. https://api.studentcouncil.eu-varna.bg
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api. Defaults to the backend http launch profile.
VITE_API_PROXY_TARGET=http://localhost:5160
