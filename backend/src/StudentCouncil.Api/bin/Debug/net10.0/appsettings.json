{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/studentcouncil-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "https://api.studentcouncil.ue-varna.bg",
    "Audience": "studentcouncil-mobile",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 30,
    "SigningKey": ""
  },
  "Identity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "AdminEmail": "",
    "AdminFullName": "Organisation President"
  },
  "RateLimiting": {
    "GlobalPerMinute": 100,
    "AuthPerMinute": 10
  },
  "Email": {
    "Provider": "Smtp",
    "From": "no-reply@studentcouncil.ue-varna.bg",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseStartTls": true
    }
  },
  "PasswordReset": {
    "LinkValidMinutes": 30,
    "ResetUrlBase": "https://app.studentcouncil.ue-varna.bg/reset-password"
  },
  "DutyPolicy": {
    "RequiredMinutesPerMonth": 120
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/uploads",
    "TasksContainer": "task-documents",
    "AvatarsContainer": "avatars",
    "MaxFileSizeMb": 25,
    "MaxAvatarSizeMb": 5
  },
  "Push": {
    "Fcm": {
      "ServiceAccountJson": ""
    },
    "Apns": {
      "KeyId": "",
      "TeamId": "",
      "BundleId": "",
      "P8Key": ""
    }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "TaskDueSoonMinutes": 15,
    "TaskOverdueMinutes": 60,
    "EventReminderMinutes": 15,
    "RefreshTokenCleanupHours": 24,
    "OrphanFileCleanupHours": 168
  },
  "AllowedHosts": "*"
}
