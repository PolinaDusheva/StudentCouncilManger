SELECT t.id, t.created_at_utc, t.created_by_id, t.deleted_at_utc, t.department_id, t.description, t.due_at_utc, t.due_soon_notified_at_utc, t.is_deleted, t.overdue_notified_at_utc, t.priority, t.scope, t.status, t.title, t.updated_at_utc, t.updated_by_id, s.task_item_id, s.member_id, s.id
FROM tasks AS t
LEFT JOIN (
    SELECT t0.task_item_id, t0.member_id, t2.id
    FROM task_assignees AS t0
    INNER JOIN (
        SELECT t1.id, t1.is_deleted
        FROM tasks AS t1
        WHERE NOT (t1.is_deleted)
    ) AS t2 ON t0.task_item_id = t2.id
    WHERE NOT (t2.is_deleted)
) AS s ON t.id = s.task_item_id
WHERE NOT (t.is_deleted) AND t.due_at_utc IS NOT NULL AND t.due_at_utc > @now AND t.due_at_utc <= @horizon AND t.status <> 'Completed' AND t.status <> 'Cancelled' AND t.due_soon_notified_at_utc IS NULL
ORDER BY t.id, s.task_item_id, s.member_id
